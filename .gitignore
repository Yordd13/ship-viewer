# Build output. Regenerated by ./mvnw on any machine.
target/

# IDE settings: this is one person's window layout and run configurations, not
# the project. The Maven wrapper is what makes the project buildable elsewhere,
# and it is committed.
.idea/
*.iml

# Credentials. keycloak/.env holds the local Keycloak's test passwords and the
# client secret; keycloak/.env.example lists the names and is committed. The
# Go pipeline's own .env lives in that repository and is never read from here.
.env

# Documentation and examples stay local, not in the repository.
/README.md
/keycloak/.env.example
